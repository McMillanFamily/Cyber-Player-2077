// CYBER-DECK // AUDIO

// Flat neon button with a hover/press glow

//For who ever comes here next update this counter
//I hate this 
//Hours wasted here 4

component CyberButton inherits Rectangle { //Cyber buttons YAY! :D
    in property <string> label;
    in property <color> accent;
    in property <color> fill;
    callback clicked();

    border-width: 1px;
    border-color: accent;
    background: ta.pressed ? accent.with-alpha(0.35)
              : ta.has-hover ? accent.with-alpha(0.18)
              : fill;
    animate background { duration: 100ms; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.accent;
        font-family: "monospace"; 
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    } //this looks so much like CSS

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Play/pause button. The icons are drawn by hand so we don't depend on
// whatever glyphs the system font happens to have.
component PlayPauseButton inherits Rectangle {
    in property <bool> playing;
    in property <color> accent: #00f3ff;
    callback clicked();

    border-width: 1px;
    border-color: accent;
    background: ta.pressed ? accent.with-alpha(0.35)
              : ta.has-hover ? accent.with-alpha(0.18)
              : #081c24;
    animate background { duration: 100ms; }

    // play triangle (nudged 2px right so it looks centered)
    if !root.playing : Path {
        x: (parent.width - self.width) / 2 + 2px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 16px;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 0 0 L 100 50 L 0 100 Z";
        fill: root.accent;
    }

    // pause bars
    if root.playing : Rectangle {
        x: parent.width / 2 - 8px;
        y: parent.height / 2 - 8px;
        width: 5px;
        height: 16px;
        background: root.accent;
    }
    if root.playing : Rectangle {
        x: parent.width / 2 + 3px;
        y: parent.height / 2 - 8px;
        width: 5px;
        height: 16px;
        background: root.accent;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "CYBER-DECK // AUDIO";
    width: 480px;
    height: 326px;
    no-frame: true;
    background: #090a0f;

    in-out property <string> track: "NO_SIGNAL // LOAD TRACK";
    in-out property <bool> playing: false;
    in-out property <float> prog: 0;       // how far through the song, 0 to 1
    in-out property <string> elapsed: "0:00";
    in-out property <string> total: "--:--";
    in-out property <float> vol: 0.8;      // 0 to 1

    callback loadFile();
    callback loadDir();
    callback togglePlay();
    callback next();
    callback prev();
    callback close();
    callback startDrag();
    callback seek(float);                  // 0 to 1 along the bar
    callback setVol(float);                // 0 to 1 along the bar

    // ticks forward while playing, which keeps the visualizer moving
    property <float> phase: 0;
    Timer {
        interval: 60ms;
        running: root.playing;
        triggered => { root.phase = mod(root.phase + 0.4, 6.2832); }
    }

    // outer neon frame
    Rectangle {
        border-width: 2px;
        border-color: #00f3ff;
        background: #0d1017;

        // a faint second border inside to fake a glow
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            border-width: 1px;
            border-color: #00f3ff.with-alpha(0.25);
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // top bar: grab it to drag the window, X to close
            HorizontalLayout {
                height: 24px;
                spacing: 8px;

                Rectangle {
                    horizontal-stretch: 1;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "SYS.AUDIO.V1 // WAYLAND_NATIVE";
                        color: #ff0055;
                        font-family: "monospace";
                        font-weight: 800;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                root.startDrag();
                            }
                        }
                    }
                }

                Rectangle {
                    width: 24px;
                    background: closeTa.has-hover ? #ff4d85 : #ff0055;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "X";
                        color: #090a0f;
                        font-weight: 900;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    closeTa := TouchArea {
                        clicked => { root.close(); }
                    }
                }
            }

            // current track name
            Rectangle {
                height: 60px;
                background: #05070a;
                border-width: 1px;
                border-color: #1f293a;

                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: parent.height;
                    text: root.track;
                    color: #00f3ff;
                    font-family: "monospace";
                    font-size: 15px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // bouncing bars (just a sine wave, not real audio analysis)
            HorizontalLayout {
                height: 56px;
                spacing: 4px;

                for i in 24 : Rectangle {
                    Rectangle {
                        width: parent.width;
                        height: root.playing
                            ? 8px + (Math.sin((i * 0.7 + root.phase) * 1rad) + 1) * 20px
                            : 4px;
                        y: parent.height - self.height;
                        background: mod(i, 2) == 0 ? #00f3ff : #ff0055;
                        animate height { duration: 60ms; }
                    }
                }
            }

            // progress bar and the two timestamps under it
            VerticalLayout {
                height: 30px;
                spacing: 2px;

                // click anywhere on the bar to jump there
                Rectangle {
                    height: 14px;

                    // empty track
                    Rectangle {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width;
                        height: 6px;
                        background: #05070a;
                        border-width: 1px;
                        border-color: #1f293a;
                    }

                    // filled part, pinned to the left
                    Rectangle {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width * clamp(root.prog, 0, 1);
                        height: 6px;
                        background: #00f3ff;
                        animate width { duration: 100ms; }
                    }

                    TouchArea {
                        clicked => {
                            root.seek(self.mouse-x / self.width);
                        }
                    }
                }

                HorizontalLayout {
                    Text {
                        text: root.elapsed;
                        color: #00f3ff;
                        font-family: "monospace";
                        font-size: 11px;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.total;
                        color: #ff0055;
                        font-family: "monospace";
                        font-size: 11px;
                    }
                }
            }

            // buttons
            HorizontalLayout {
                height: 40px;
                spacing: 12px;

                CyberButton {
                    label: "[ LOAD_FILE ]";
                    accent: #ff0055;
                    fill: #1a0b14;
                    clicked => { root.loadFile(); }
                }

                CyberButton {
                    label: "[ LOAD_DIR ]";
                    accent: #ff0055;
                    fill: #1a0b14;
                    clicked => { root.loadDir(); }
                }

                CyberButton {
                    width: 40px;
                    label: "<<";
                    accent: #00f3ff;
                    fill: #081c24;
                    clicked => { root.prev(); }
                }

                PlayPauseButton {
                    width: 72px;
                    playing: root.playing;
                    clicked => { root.togglePlay(); }
                }

                CyberButton {
                    width: 40px;
                    label: ">>";
                    accent: #00f3ff;
                    fill: #081c24;
                    clicked => { root.next(); }
                }
            }

            // volume: click or drag along the bar
            HorizontalLayout {
                height: 20px;
                spacing: 10px;

                Text {
                    width: 32px;
                    text: "VOL"; // VOLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLLUUUUUUUUUUUUUUUUUUMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMEEEEEEEEEEEEEEEEEEEEE
                    color: #ff0055;
                    font-family: "monospace";
                    font-size: 11px;
                    vertical-alignment: center;     //Dont ask me why i had to remake this one block of code 50 times :)
                }

                Rectangle {
                    horizontal-stretch: 1;

                    // empty track
                    Rectangle {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width;
                        height: 8px;
                        background: #05070a;
                        border-width: 1px;
                        border-color: #1f293a;
                    }

                    // filled part, pinned to the left
                    Rectangle {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: parent.width * clamp(root.vol, 0, 1);
                        height: 8px;
                        background: #ff0055;
                    }

                    // the little handle
                    Rectangle {
                        x: parent.width * clamp(root.vol, 0, 1) - self.width / 2;
                        y: (parent.height - self.height) / 2;
                        width: 6px;
                        height: 16px;
                        background: volTa.pressed ? #ffffff : #ff4d85;
                    }

                    volTa := TouchArea {
                        // a plain click sets the volume right away...
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                root.vol = clamp(self.mouse-x / self.width, 0, 1);
                                root.setVol(root.vol);
                            }
                        }
                        // ...and dragging keeps updating it
                        moved => {
                            if (self.pressed) {
                                root.vol = clamp(self.mouse-x / self.width, 0, 1);
                                root.setVol(root.vol);
                            }
                        }
                    }
                }

                Text {
                    width: 40px;
                    text: "\{Math.round(root.vol * 100)}%";
                    color: #ff0055;
                    font-family: "monospace";
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }
}
